{
    "name": "compwright/docker-ec2-metadata",
    "type": "library",
    "description": "AWS EC2 metadata service simulator for Docker",
    "license": "MIT",
    "authors": [
        {
            "name": "Jonathon Hill",
            "email": "jonathon@compwright.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Compwright\\DockerEc2Metadata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Compwright\\DockerEc2Metadata\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5.13",
        "aws/aws-sdk-php": "^3.390",
        "composer-runtime-api": "^2.2",
        "league/route": "^7.0",
        "psr/log": "^3.0",
        "react/http": "^1.12",
        "react/socket": "^1.13",
        "symfony/console": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2"
    },
    "bin": [
        "bin/docker-ec2-metadata.php"
    ]
}
